local function UseTool(toolName)
    local p = LocalPlayer

    for _, t in ipairs(p.Backpack:GetChildren()) do
        if string.find(string.lower(t.Name), string.lower(toolName)) then
            t.Parent = p.Character
            t:Activate()
            t.Parent = p.Backpack
            break
        end
    end
end

local function StartAutoUse(toolName)
    if AutoUseLoops[toolName] then return end

    AutoUseLoops[toolName] = task.spawn(function()
        while AutoUseToggles[toolName] and AutoUseToggles[toolName].Value do
            UseTool(toolName)
            task.wait(AutoUseDelay)
        end

        AutoUseLoops[toolName] = nil
    end)
end

local function StopAutoUse(toolName)
    AutoUseLoops[toolName] = nil
end

local AFKHooked = false

local function ApplyAFKBlock(state)
    getgenv().AFKBlock = state

    local AFK = game:GetService("ReplicatedStorage"):FindFirstChild("AFK")
    if not AFK then return end

    if not AFKHooked then
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)

        mt.__namecall = newcclosure(function(self, ...)
            if getgenv().AFKBlock and self == AFK and getnamecallmethod() == "FireServer" then return end
            return old(self, ...)
        end)

        setreadonly(mt, true)
        AFKHooked = true
    end
end

local function FireAFK(value)
    local Event = game:GetService("ReplicatedStorage"):FindFirstChild("AFK")
    if not Event then return end
