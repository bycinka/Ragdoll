local function FreezeCharacter()
    local char = LocalPlayer.Character
    if not char then return end

    for _, x in next, char:GetDescendants() do
        if x:IsA("BasePart") and not x.Anchored then
            x.Anchored = true
        end
    end
end

local function UnfreezeCharacter()
    local char = LocalPlayer.Character
    if not char then return end

    for _, x in next, char:GetDescendants() do
        if x:IsA("BasePart") and x.Anchored then
            x.Anchored = false
        end
    end
end

local function ActivateMines()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local minefield = workspace:FindFirstChild("Minefield")
    if not minefield then return end

    local mines = minefield:FindFirstChild("Mines")
    if not mines then return end

    for _, v in ipairs(mines:GetDescendants()) do
        if v:IsA("BasePart") then
            pcall(function()
                firetouchinterest(hrp, v, 0)
