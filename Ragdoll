local function SelectFace(faceId, button)
    if not FaceSet[faceId] then
        warn("[FacePicker] Rejected face ID:", faceId)
        return
    end

    IsHeadless = false
    if Headless.Value then Headless:SetValue(false) end

    RefreshHighlights()
    button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)

    CurrentFace = faceId
    FireAppearance(CurrentMesh, CurrentFace, false, false)
end

local function SelectHead(headData, button)
    if headData.reset then
        CurrentMesh = nil
        CurrentFace = nil
        IsHeadless = false
        RefreshHighlights()
        FireAppearance(nil, nil, false, true)
        return
    end

    if headData.headless then
        Headless:SetValue(true)
        return
    end

    if not HeadMeshSet[headData.mesh] then
        warn("[HeadPicker] Rejected head mesh:", headData.mesh)
        return
    end

    RefreshHighlights()
    if button then
        button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    end

    IsHeadless = false
    CurrentMesh = headData.mesh
    FireAppearance(CurrentMesh, CurrentFace, false, false)
end

