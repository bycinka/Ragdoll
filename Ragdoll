local function FindQuack(container)
    if not container then return nil end

    local duck = container:FindFirstChild("DuckProp")
    if not duck then return nil end

    local handle = duck:FindFirstChild("Handle")
    if not handle then return nil end

    local quack = handle:FindFirstChild("Quack")
    if not quack or not quack:IsA("Sound") then return nil end

    return quack
end

local function ActivateDuckSelf()
    DeactivateDuckSelf()

    task.spawn(function()
        local player = LocalPlayer
        local backpack = player:WaitForChild("Backpack")
        local character = player.Character or player.CharacterAdded:Wait()

        local function tryHook(container)
            local quack = FindQuack(container)
            if not quack then return end

            if DuckSelfConnection then
                DuckSelfConnection:Disconnect()
                DuckSelfConnection = nil
            end

            DuckSelfConnection = quack:GetPropertyChangedSignal("Playing"):Connect(function()
                if quack.Playing then
                    ActivateMines()
                end
            end)
        end

        tryHook(character)
        tryHook(backpack)

        table.insert(DuckSelfConnections, backpack.ChildAdded:Connect(function()
            tryHook(backpack)
        end))

        table.insert(DuckSelfConnections, player.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            tryHook(char)
            table.insert(DuckSelfConnections, char.ChildAdded:Connect(function()
                tryHook(char)
            end))
        end))
    end)
end

local function DeactivateDuckSelf()
    if DuckSelfConnection then
        DuckSelfConnection:Disconnect()
        DuckSelfConnection = nil
    end

    for _, conn in ipairs(DuckSelfConnections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    DuckSelfConnections = {}
end

local function TryHookDuckQuack(player)
    if DuckAllConnections[player] then return end

    task.spawn(function()
        local backpack = player:FindFirstChildOfClass("Backpack")
        local character = player.Character

        local quack = FindQuack(character) or FindQuack(backpack)
        if not quack then return end
        if DuckAllConnections[player] then return end

        DuckAllConnections[player] = quack:GetPropertyChangedSignal("Playing"):Connect(function()
            if quack.Playing then
                ActivateMines()
            end
        end)
    end)
end

local function ActivateDuckAll()
    local function watchPlayer(player)
        TryHookDuckQuack(player)

        if not DuckAllWatches[player] then
            DuckAllWatches[player] = {}

            local function watchContainer(container)
                if not container then return end

                table.insert(DuckAllWatches[player], container.ChildAdded:Connect(function(child)
                    if child.Name == "DuckProp" or child.Name == "Handle" or child.Name == "Quack" then
                        TryHookDuckQuack(player)
                    end
                end))
            end

            watchContainer(player:FindFirstChildOfClass("Backpack"))
            watchContainer(player.Character)

            table.insert(DuckAllWatches[player], player.ChildAdded:Connect(function(child)
                if child:IsA("Backpack") then
                    watchContainer(child)
                    TryHookDuckQuack(player)
                end
            end))

            table.insert(DuckAllWatches[player], player.CharacterAdded:Connect(function(char)
                task.wait(0.5)
                watchContainer(char)
                TryHookDuckQuack(player)
            end))
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        watchPlayer(player)
    end

    if not getgenv().DuckAllPlayerAddedHooked then
        getgenv().DuckAllPlayerAddedHooked = true
        Players.PlayerAdded:Connect(function(player)
            if getgenv().DuckAllActive then
                watchPlayer(player)
            end
        end)
    end
end

local function DeactivateDuckAll()
    for player, conn in pairs(DuckAllConnections) do
        pcall(function()
            conn:Disconnect()
        end)
        DuckAllConnections[player] = nil
    end

    for player, conns in pairs(DuckAllWatches) do
        for _, conn in ipairs(conns) do
            pcall(function()
                conn:Disconnect()
            end)
        end
        DuckAllWatches[player] = nil
    end
end

