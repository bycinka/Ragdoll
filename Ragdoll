    Description = "Задержка авто-использования",
    Default = "0.5",
    Numeric = true, Finished = true,
    Callback = function(v) local n = tonumber(v) if n then AutoUseDelay = n end end
})

Tabs.Tools:AddButton({
    Title = "Clear",
    Description = "Удалить тумблеры отсутствующих предметов",
    Callback = function()
        local backpack = LP:FindFirstChildOfClass("Backpack")
        local character = LP.Character
        for toolName, toggle in pairs(AutoUseToggles) do
            local inBp = backpack and backpack:FindFirstChild(toolName)
            local inChar = character and character:FindFirstChild(toolName)
            if not inBp and not inChar then
                pcall(function()
                    if toggle.Value then toggle:SetValue(false) end
                    toggle:Destroy()
                end)
                AutoUseToggles[toolName] = nil
                AutoUseLoops[toolName] = nil
            end
        end
    end
})

local function BuildToolsTab()
    local backpack = LP:WaitForChild("Backpack")
    local function addTool(tool)
        if not tool:IsA("Tool") or AutoUseToggles[tool.Name] then return end
        local toggle
        toggle = Tabs.Tools:AddToggle("Tool_" .. tool.Name, {
            Title = tool.Name,
            Description = "Авто-использование " .. tool.Name,
            Default = false,
            Callback = function(v)
                AutoUseToggles[tool.Name] = toggle
                if v then StartAutoUse(tool.Name) else StopAutoUse(tool.Name) end
            end
        })
        AutoUseToggles[tool.Name] = toggle
    end
    for _, tool in ipairs(backpack:GetChildren()) do addTool(tool) end
    backpack.ChildAdded:Connect(function(tool) task.wait(0.1) addTool(tool) end)
end

