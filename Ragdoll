local HeadlessConnection = nil

local function ApplyHeadless()
    local Event = game:GetService("ReplicatedStorage"):FindFirstChild("ApplyAppearance")
    if not Event then return end
    Event:FireServer(
        nil,
        nil,
        true,
        false
    )
end

local HeadlessToggle = Tabs.Heads:AddToggle("Headless", {
    Title = "Headless",
    Default = false
})

HeadlessToggle:OnChanged(function(Value)
    if Value then
        ApplyHeadless()

        local player = game.Players.LocalPlayer
        HeadlessConnection = player.CharacterAdded:Connect(function()
            ApplyHeadless()
        end)
    else
        if HeadlessConnection then
            HeadlessConnection:Disconnect()
            HeadlessConnection = nil
        end
    end
end)

