Tabs.Ragdoll:AddButton({
    Title = "fakepush",
    Description = "Просто анимация",
    Callback = function()
        local Players = game:GetService("Players")
        local player = Players.LocalPlayer

        local tool = Instance.new("Tool")
        tool.RequiresHandle = false
        tool.Name = "fakepush"
        tool.Parent = player.Backpack

        local char = player.Character or player.CharacterAdded:Wait()
        local humanoid = char:WaitForChild("Humanoid")
        local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://18550756434"

        local track = animator:LoadAnimation(anim)

        tool.Activated:Connect(function()
            track:Play()
        end)
    end
})

local function TeleportRespawn()
    local p = game.Players.LocalPlayer
    local cf = p.Character.HumanoidRootPart.CFrame
    p.Character.Humanoid.Health = 0
    local ch = p.CharacterAdded:Wait()
    task.wait(RespawnDelay)
    ch.HumanoidRootPart.CFrame = cf
end

