local RespawnDelay = 0.8

local function ApplyRagdollToggle(state)
    local f = workspace:FindFirstChild(game.Players.LocalPlayer.Name)

    for _, c in ipairs(f and f:GetChildren() or {}) do
        if c:IsA("LocalScript") then
            local ok, code = pcall(decompile, c)
            if ok and code and code:find("LocalRagdollEvent") and code:find("RagdollState") and code:find("FreeCoins") then
                c.Disabled = state
            end
        end
    end
end

local Toggle = Tabs.Ragdoll:AddToggle("RagdollToggle", {
    Title = "Ragdoll script",
    Description = "Переключить ragdoll скрипт",
    Default = false
})

Toggle:OnChanged(function(Value)
    ApplyRagdollToggle(Value)
end)

ApplyRagdollToggle(Options.RagdollToggle.Value)

local function ApplyRagdollRemote(state)
    local e = game:GetService("ReplicatedStorage"):FindFirstChild("RagdollEvent")
    if not e then return end

    if state then
        for _, c in ipairs(getconnections(e.Event)) do
            c:Disable()
        end
    else
        for _, c in ipairs(getconnections(e.Event)) do
            c:Enable()
        end
    end
end

