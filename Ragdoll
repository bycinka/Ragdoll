local CoreGui = game:GetService("CoreGui")

local function HookGui(gui)
    if not gui:IsA("ScreenGui") then return end
    if gui.Name ~= "ScreenGui" then return end

    gui.Destroying:Connect(function()
        pcall(function()
            if Options.RagdollToggle.Value then RagdollToggle:SetValue(false) end
            if Options.RagdollRemote.Value then RagdollRemote:SetValue(false) end
            if Options.RagdollFall.Value then RagdollFall:SetValue(false) end
            if Options.RagdollDelay.Value then RagdollDelay:SetValue(false) end
            if Options.Headless.Value then Headless:SetValue(false) end
            if Options.BoomboxRedeem.Value then BoomboxToggle:SetValue(false) end
            if Options.AFKBlock.Value then AFKToggle:SetValue(false) end
            if Options.CmdrToggle.Value then CmdrToggle:SetValue(false) end
            if Options.DuckSelfToggle.Value then DuckSelfToggle:SetValue(false) end
            if Options.DuckAllToggle.Value then DuckAllToggle:SetValue(false) end
            if Options.RedeemQuackToggle.Value then RedeemQuackToggle:SetValue(false) end
            if Options.RedeemLabubuToggle.Value then RedeemLabubuToggle:SetValue(false) end
            if Options.RedeemSignToggle.Value then RedeemSignToggle:SetValue(false) end
            if Options.RedeemBcjdoansToggle.Value then RedeemBcjdoansToggle:SetValue(false) end

            for _, toolToggle in pairs(AutoUseToggles) do
                pcall(function()
                    if toolToggle.Value then toolToggle:SetValue(false) end
                end)
            end

            for _, conn in pairs(RagdollRespawnHooks) do
                pcall(function()
                    conn:Disconnect()
                end)
            end

            if RedeemRespawnHook then
                pcall(function()
                    RedeemRespawnHook:Disconnect()
                end)
                RedeemRespawnHook = nil
            end
        end)
    end)
end

for _, g in ipairs(CoreGui:GetChildren()) do
    HookGui(g)
end
CoreGui.ChildAdded:Connect(HookGui)

