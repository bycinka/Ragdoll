local ActivateDuckSelf, DeactivateDuckSelf

ActivateDuckSelf = function()
    DeactivateDuckSelf()
    task.spawn(function()
        local backpack = LP:WaitForChild("Backpack")
        local character = LP.Character or LP.CharacterAdded:Wait()

        local function tryHook(c)
            local quack = FindQuack(c)
            if not quack then return end
            if DuckSelfConnection then DuckSelfConnection:Disconnect() end
            DuckSelfConnection = quack:GetPropertyChangedSignal("Playing"):Connect(function()
                if quack.Playing then ActivateMines() end
            end)
        end

        tryHook(character) tryHook(backpack)
        table.insert(DuckSelfConns, backpack.ChildAdded:Connect(function() tryHook(backpack) end))
        table.insert(DuckSelfConns, LP.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            tryHook(char)
            table.insert(DuckSelfConns, char.ChildAdded:Connect(function() tryHook(char) end))
        end))
    end)
end

DeactivateDuckSelf = function()
    if DuckSelfConnection then DuckSelfConnection:Disconnect() DuckSelfConnection = nil end
    for _, c in ipairs(DuckSelfConns) do pcall(function() c:Disconnect() end) end
    DuckSelfConns = {}
end

local function TryHookDuckQuack(player)
    if DuckAllConns[player] then return end
    task.spawn(function()
        local quack = FindQuack(player.Character) or FindQuack(player:FindFirstChildOfClass("Backpack"))
        if not quack or DuckAllConns[player] then return end
        DuckAllConns[player] = quack:GetPropertyChangedSignal("Playing"):Connect(function()
            if quack.Playing then ActivateMines() end
        end)
    end)
end

local function ActivateDuckAll()
    local function watchPlayer(player)
        TryHookDuckQuack(player)
        if DuckAllWatches[player] then return end
        DuckAllWatches[player] = {}

        local function watchContainer(c)
            if not c then return end
            table.insert(DuckAllWatches[player], c.ChildAdded:Connect(function(child)
                if child.Name == "DuckProp" or child.Name == "Handle" or child.Name == "Quack" then
                    TryHookDuckQuack(player)
                end
            end))
        end

        watchContainer(player:FindFirstChildOfClass("Backpack"))
        watchContainer(player.Character)
        table.insert(DuckAllWatches[player], player.ChildAdded:Connect(function(child)
            if child:IsA("Backpack") then watchContainer(child) TryHookDuckQuack(player) end
        end))
        table.insert(DuckAllWatches[player], player.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            watchContainer(char)
            TryHookDuckQuack(player)
        end))
    end

    for _, player in ipairs(Players:GetPlayers()) do watchPlayer(player) end
    if not getgenv().DuckAllPlayerAddedHooked then
        getgenv().DuckAllPlayerAddedHooked = true
        Players.PlayerAdded:Connect(function(player)
            if getgenv().DuckAllActive then watchPlayer(player) end
        end)
    end
end

local function DeactivateDuckAll()
    for player, conn in pairs(DuckAllConns) do
        pcall(function() conn:Disconnect() end)
        DuckAllConns[player] = nil
    end
    for player, conns in pairs(DuckAllWatches) do
        for _, conn in ipairs(conns) do pcall(function() conn:Disconnect() end) end
        DuckAllWatches[player] = nil
    end
end

