local BoomboxConnection = nil
local BoomboxBackpackConn = nil

local function HookBoombox(tool)
    if not tool:IsA("Tool") then return end
    if tool.Name ~= "BOOMBox" and tool.Name:lower() ~= "boombox" then return end

    if BoomboxConnection then
        BoomboxConnection:Disconnect()
        BoomboxConnection = nil
    end

    BoomboxConnection = tool.Activated:Connect(function()
        task.wait(RedeemDelay)
        ApplyRedeem("boombox")
    end)
end

local function ActivateBoombox()
    ApplyRedeem("boombox")

    local player = LocalPlayer
    local backpack = player:FindFirstChildOfClass("Backpack")
    local character = player.Character

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            HookBoombox(item)
        end
    end

    if character then
        for _, item in ipairs(character:GetChildren()) do
            HookBoombox(item)
        end
    end

    if backpack and not BoomboxBackpackConn then
        BoomboxBackpackConn = backpack.ChildAdded:Connect(HookBoombox)
    end
end

local function DeactivateBoombox()
    if BoomboxConnection then
        BoomboxConnection:Disconnect()
        BoomboxConnection = nil
    end
    if BoomboxBackpackConn then
        BoomboxBackpackConn:Disconnect()
        BoomboxBackpackConn = nil
    end
end

