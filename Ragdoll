local function BuildToolsTab()
    local player = LocalPlayer
    local backpack = player:WaitForChild("Backpack")

    local function addTool(tool)
        if not tool:IsA("Tool") then return end
        if AutoUseToggles[tool.Name] then return end

        local toggle
        toggle = Tabs.Tools:AddToggle("Tool_" .. tool.Name, {
            Title = tool.Name,
            Description = "Авто-использование " .. tool.Name,
            Default = false,
            Callback = function(Value)
                AutoUseToggles[tool.Name] = toggle

                if Value then
                    StartAutoUse(tool.Name)
                else
                    StopAutoUse(tool.Name)
                end
            end
        })

        AutoUseToggles[tool.Name] = toggle
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        addTool(tool)
    end

    backpack.ChildAdded:Connect(function(tool)
        task.wait(0.1)
        addTool(tool)
    end)
end

