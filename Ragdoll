        MonkeyAllConns[player] = {}
        for _, s in ipairs(sounds) do
            table.insert(MonkeyAllConns[player], s:GetPropertyChangedSignal("Playing"):Connect(function()
                if s.Playing then ActivateMines() end
            end))
        end
    end)
