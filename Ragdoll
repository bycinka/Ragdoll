end

local function ApplyRagdollToggle(state)
    local f = workspace:FindFirstChild(LocalPlayer.Name)

    for _, c in ipairs(f and f:GetChildren() or {}) do
        if c:IsA("LocalScript") then
            local ok, code = pcall(decompile, c)
            if ok and code and code:find("LocalRagdollEvent") and code:find("RagdollState") and code:find("FreeCoins") then
                c.Disabled = state
            end
        end
    end
end

local function ApplyRagdollRemote(state)
    local e = game:GetService("ReplicatedStorage"):FindFirstChild("RagdollEvent")
    if not e then return end

    if state then
        for _, c in ipairs(getconnections(e.Event)) do
            c:Disable()
        end
    else
        for _, c in ipairs(getconnections(e.Event)) do
            c:Enable()
        end
    end
end

